# Эти переменные совпадают с окружением хостинга. Локально достаточно
# заполнить DATABASE_URL, REDIS_URL, DEEPSEEK_API_KEY, FISH_AUDIO_*.

# --- App ---
ENVIRONMENT=development
APP_NAME=BuildPulse
APP_VERSION=0.1.0
API_URL=http://localhost:8000
APP_URL=http://localhost:5173
SECRET_KEY=change-me-in-production-please
ADMIN_TOKEN=change-me-admin
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
LOG_LEVEL=INFO

# --- DB / Cache ---
DATABASE_URL=postgresql+psycopg://buildpulse:buildpulse@postgres:5432/buildpulse
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- AI providers ---
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=12
AI_MAX_RETRIES=2
AI_CACHE_TTL_HOURS=24
MAX_TOKEN=2048

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
YANDEX_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# --- Assistant (Jarvis) ---
ASSISTANT_NAME=Джарвис
ASSISTANT_GREETING=Привет, командор! Меня зовут Джарвис — твой персональный помощник. Можешь задать вопрос голосом или написать в поисковике.
ASSISTANT_MODEL=deepseek-chat
ASSISTANT_VOICE_LANG=ru-RU

# --- Voice ---
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_BASE_URL=https://api.fish.audio
FISH_AUDIO_MODEL=speech-1.6
DEEPGRAM_API_KEY=
VAD_MODE=2

# --- Emotion / extras ---
HUME_API_KEY=
TAVILY_API_KEY=
OPENWEATHER_API_KEY=

# --- Alerts ---
ALERT_STRESS_THRESHOLD=4.2
ALERT_SAFETY_THRESHOLD=3.0
ALERT_WEBHOOK_URL=

# --- VK (страница компании) ---
VK_API_VERSION=5.199
VK_SERVICE_TOKEN=
VK_USER_TOKEN=
VK_GROUP_DOMAIN=smp2025house
VK_POSTS_LIMIT=30
VK_CACHE_TTL_MINUTES=30

# --- Advisor (рекомендации) ---
ADVISOR_ENABLED=true
ADVISOR_MODEL=deepseek-chat

# --- Notifications ---
TELEGRAM_TOKEN=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=

# --- Sentry / Monitoring ---
SENTRY_DSN=
LOG_FORMAT=json
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
